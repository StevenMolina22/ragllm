# RagLLM Environment Variables
# Copy this file to .env and fill in the appropriate values for your chosen model

# =================================================================
# DeepSeek Configuration
# =================================================================

# API key for DeepSeek (REQUIRED for DeepSeek model)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Base URL for DeepSeek API (OPTIONAL - Default: https://openrouter.ai/api/v1)
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek model to use (OPTIONAL - Default: deepseek/deepseek-r1:free)
# Available models: https://platform.deepseek.com/models
DEEPSEEK_MODEL=deepseek/deepseek-r1:free

# =================================================================
# OpenRouter Configuration
# =================================================================

# API key for OpenRouter (REQUIRED for OpenRouter model)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model to use (OPTIONAL - Default: google/gemini-2.0-flash-exp:free)
# Available models: https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# =================================================================
# Ollama Configuration (Local LLM)
# =================================================================

# Ollama model to use (OPTIONAL - Default: llama3.1:8b)
# Available models depend on your local Ollama installation
# See: https://ollama.com/library
OLLAMA_MODEL=llama3.1:8b

# =================================================================
# General Configuration
# =================================================================

# HuggingFace embedding model (OPTIONAL - Default: BAAI/bge-small-en)
# Used for embedding documents for vector search
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en

